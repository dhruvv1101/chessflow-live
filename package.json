    "chess.js": "1.4.0",
    "react": "19.2.0",
    "react-chessboard": "5.12.1",
    "react-dom": "19.2.0",
    "stockfish": "19.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.39.1",
    "eslint-plugin-react": "7.37.5",
    "fake-indexeddb": "6.2.4",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
