{
  "name": "chessflow-live",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:openings && vite build",
    "build:openings": "node scripts/build-openings.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "test:smoke": "playwright test",
    "engine:build": "node scripts/engine-container.mjs build",
    "engine:start": "node scripts/engine-container.mjs start",
    "engine:stop": "node scripts/engine-container.mjs stop",
    "engine:logs": "node scripts/engine-container.mjs logs",
    "engine:check": "node scripts/engine-container.mjs check",
    "copy:engine": "node scripts/copy-engine.mjs",
    "postinstall": "npm run copy:engine"
